DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""
CRON_SECRET=""
E2E_TEST_MODE=""

# ─── Agent operations ────────────────────────────────────────────────

# Call room names are HMACs under this secret (ADR-004). On a public Jitsi
# instance anyone who knows a room name can join, so this is what keeps rooms
# unguessable. Set it SEPARATELY from NEXTAUTH_SECRET: sharing them means
# rotating call rooms would invalidate every login session.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALL_ROOM_SECRET=""

# ICS feed tokens (ADR-005). A feed URL is effectively a password — calendar
# clients fetch it unattended, with no session, and store it in plaintext.
# Rotating this revokes every subscribed feed.
ICS_FEED_SECRET=""

# Jitsi domain. Defaults to the PUBLIC meet.jit.si, which is fine internally
# and wrong for a customer call about their invoices. Point this at a
# self-hosted instance before any client uses calls.
NEXT_PUBLIC_JITSI_DOMAIN="meet.jit.si"

# Calls are off for client tenants unless this is "true" (ADR-004). Turning
# them on is a product decision with support implications, not a UI toggle.
ENABLE_CLIENT_CALLS=""

# The SAMPLE DATA badge shows unless this is exactly "false". It defaults to
# ON so a missing or misspelled value over-warns rather than silently
# presenting seeded numbers as real activity.
NEXT_PUBLIC_SAMPLE_DATA=""

# Signs the per-person tokens that report Claude Code sessions into the fleet.
INGEST_SECRET=""

# The only GitHub logins allowed to sign in. Fails CLOSED: empty means nobody.
ALLOWED_GITHUB_LOGINS=""

# The room agent that summarises the team chat. Off until this is set.
# The default model is a free tier; override with OPENROUTER_MODEL.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
